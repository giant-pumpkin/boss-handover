<mxfile host="app.diagrams.net"><diagram name="Package to jobs" id="p2j"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="540" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;How a package creates jobs&lt;/b&gt;  &lt;span style='color:#64748B'&gt;— Ma - Packages → Job locations → automation → Jobs&lt;/span&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1240" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Ma Package - 001" style="swimlane;startSize=36;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=14;fillColor=#1E3A5F;strokeColor=#1E3A5F;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;shadow=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="250" height="230" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Ma Item 001&lt;/b&gt;&lt;br&gt;&lt;span style='color:#9D174D'&gt;Ma - Reactive&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;" vertex="1" parent="c12"><mxGeometry x="16" y="50" width="218" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ma Item 002&lt;/b&gt;&lt;br&gt;&lt;span style='color:#075985'&gt;Ma - Preventive&lt;/span&gt; · Cycle MAC-2026 - 1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="c12"><mxGeometry x="16" y="110" width="218" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Ma Item 003&lt;/b&gt;&lt;br&gt;&lt;span style='color:#075985'&gt;Ma - Preventive&lt;/span&gt; · Cycle MAC-2026 - 2" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="c12"><mxGeometry x="16" y="170" width="218" height="50" as="geometry"/></mxCell><mxCell id="c16" value="Job locations · Store A" style="swimlane;startSize=36;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=14;fillColor=#C2410C;strokeColor=#C2410C;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;shadow=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="250" height="170" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Ma - Package - Add new&lt;/b&gt;&lt;br&gt;= Ma Package - 001" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FFEDD5;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="c16"><mxGeometry x="16" y="50" width="218" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Ma - Package&lt;/b&gt;&lt;br&gt;&lt;span style='color:#64748B'&gt;filled in by the automation&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="c16"><mxGeometry x="16" y="110" width="218" height="44" as="geometry"/></mxCell><mxCell id="c19" value="Automation · Create MA jobs - Jobs" style="swimlane;startSize=36;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=14;fillColor=#6D28D9;strokeColor=#6D28D9;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;shadow=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="270" height="270" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1. File the package&lt;/b&gt;&lt;br&gt;Add to Ma - Package, clear Add new" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;" vertex="1" parent="c19"><mxGeometry x="16" y="50" width="238" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Read the menu&lt;/b&gt;&lt;br&gt;Find items in Ma Package - 001" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;" vertex="1" parent="c19"><mxGeometry x="16" y="120" width="238" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;3. Create jobs&lt;/b&gt;&lt;br&gt;One job per item for Store A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;strokeWidth=1.5;" vertex="1" parent="c19"><mxGeometry x="16" y="190" width="238" height="56" as="geometry"/></mxCell><mxCell id="c23" value="Jobs · created for Store A" style="swimlane;startSize=36;html=1;rounded=1;arcSize=4;fontStyle=1;fontSize=14;fillColor=#15803D;strokeColor=#15803D;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;shadow=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="280" height="290" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Job · Ma - Reactive&lt;/b&gt;&lt;br&gt;Ma - Item: Ma Item 001&lt;br&gt;Status: Unscheduled · no date" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=1.5;" vertex="1" parent="c23"><mxGeometry x="16" y="50" width="248" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Job · Ma - Preventive&lt;/b&gt;&lt;br&gt;Ma - Item: Ma Item 002&lt;br&gt;Status: Unscheduled · no date" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="c23"><mxGeometry x="16" y="130" width="248" height="70" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Job · Ma - Preventive&lt;/b&gt;&lt;br&gt;Ma - Item: Ma Item 003&lt;br&gt;Status: Unscheduled · no date" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=12;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;" vertex="1" parent="c23"><mxGeometry x="16" y="210" width="248" height="70" as="geometry"/></mxCell><mxCell id="c27" value="attached to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="fires" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="creates 3 jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#334155;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#334155;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="reads the items" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;dashPattern=6 4;strokeColor=#334155;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;fontColor=#334155;fontStyle=2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="400"/><mxPoint x="855" y="400"/></Array></mxGeometry></mxCell><mxCell id="c31" value="Every job copies Job type, Ma - Item, Ma - Package and Location. Its cycle is a lookup through its item. Repeat for every store the package is attached to: &lt;b&gt;stores × items = jobs&lt;/b&gt; (e.g. 93 × 3 = 279)." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#334155;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1320" height="40" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style='background:#FCE7F3;border:1px solid #DB2777;padding:2px 8px'&gt;Ma - Reactive&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;span style='background:#E0F2FE;border:1px solid #0284C7;padding:2px 8px'&gt;Ma - Preventive&lt;/span&gt;" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="400" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>