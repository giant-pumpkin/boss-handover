  {
   "parameters": {
    "jsCode": "const BASE_ID    = 'appRor1ipbYAb4K7z';\nconst WEBHOOK_ID = 'achTRaF6zyL0VZOjf';\nconst TABLE_ID   = 'tblyNA73D9jldeEir';\nconst PAT        = '<AIRTABLE_PAT_REDACTED>';\n\nconst COL = {\n  fldHd1UM8vPnkvUPk: 'field_display',\n  fldJ0WRQcaHEhqXth: 'service_location',\n  fldUFBjD2HRxmlM38: 'subscription_type',\n  fldozqn9HeQyxCKso: 'subscription_contract',\n  fldr20YOR1yjLQMY8: 'brand',\n  fldZMSD7znWAZlIm5: 'brand_owner',\n  fldAlD46wNjWDNAdc: 'start_date',\n  fldQK7TJy8kpustEb: 'end_date',\n  fldAzhmWmuhSX6ppN: 'inventory',\n  fld22c3r9LiQw6j4F: 'status',\n};\n\nfunction flatten(v) {\n  if (v == null) return null;\n  if (typeof v !== 'object') return v;\n  if (!Array.isArray(v) && v.name !== undefined) return v.name;\n  if (v.valuesByLinkedRecordId) {\n    const out = [];\n    for (const id of v.linkedRecordIds || []) {\n      for (const item of v.valuesByLinkedRecordId[id] || []) {\n        if (item != null) out.push(typeof item === 'object' ? item.name : item);\n      }\n    }\n    return out.join(', ') || null;\n  }\n  if (Array.isArray(v)) {\n    return v.filter(x => x != null)\n            .map(x => typeof x === 'object' ? x.name : x)\n            .join(', ') || null;\n  }\n  return null;\n}\n\nlet cursor = $input.first().json.cursor;\nconst rows = new Map();   // record_id → row, so later payloads overwrite earlier\nconst dead = new Set();\n\nwhile (true) {\n  const res = await this.helpers.httpRequest({\n    url: `https://api.airtable.com/v0/bases/${BASE_ID}/webhooks/${WEBHOOK_ID}/payloads`,\n    qs: { cursor },\n    headers: { Authorization: `Bearer ${PAT}` },\n  });\n\n  for (const p of res.payloads) {\n    const t = p.changedTablesById?.[TABLE_ID];\n    if (!t) continue;\n\n    for (const [rid, rec] of Object.entries({\n      ...t.createdRecordsById,\n      ...t.changedRecordsById,\n    })) {\n      const cells = {\n        ...rec.unchanged?.cellValuesByFieldId,\n        ...rec.current?.cellValuesByFieldId,\n        ...rec.cellValuesByFieldId,\n      };\n      const row = { record_id: rid };\n      for (const [fid, col] of Object.entries(COL)) row[col] = flatten(cells[fid]);\n      rows.set(rid, row);\n      dead.delete(rid);\n    }\n\n    for (const rid of t.destroyedRecordIds || []) {\n      dead.add(rid);\n      rows.delete(rid);\n    }\n  }\n\n  cursor = res.cursor;\n  if (!res.mightHaveMore) break;\n}\n\nconst out = [\n  ...[...rows.values()].map(r => ({ json: { op: 'upsert', ...r } })),\n  ...[...dead].map(id => ({ json: { op: 'delete', record_id: id } })),\n];\n\n// always emit at least one item so the cursor node still runs\nout.push({ json: { op: 'cursor', cursor } });\nreturn out;"
   },
