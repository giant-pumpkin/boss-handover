 "nodes": [
  {
   "parameters": {
    "jsCode": "const idToName = {};\n\n// All 3 lookup tables come through the merge\nfor (const item of $('Merge1').all()) {\n  const raw = item.json;\n  const id = raw.id;\n  // Job Locations + BOM have fields.ID, Partners have fields.Name\n  const name = raw.fields?.ID ?? raw.fields?.Name ?? raw.ID ?? raw.Name ?? id;\n  idToName[id] = name;\n}\n\nconst linkedFields = ['Location', 'BOM', 'Partner', 'Country', 'BOM resources'];\n\nreturn $('Fetch Jobs').all().map(item => {\n  const raw = item.json.fields ?? item.json;\n  const row = {};\n\n  for (const [key, val] of Object.entries(raw)) {\n    if (Array.isArray(val)) {\n      if (linkedFields.includes(key)) {\n        row[key] = val.map(v => idToName[v] ?? v).join(', ');\n      } else {\n        row[key] = val.join(', ');\n      }\n    } else if (typeof val === 'object' && val !== null) {\n      row[key] = val.error ?? JSON.stringify(val);\n    } else {\n      row[key] = val;\n    }\n  }\n\n  row['airtable_record_id'] = item.json.id;\n  return { json: row };\n});"
   },
