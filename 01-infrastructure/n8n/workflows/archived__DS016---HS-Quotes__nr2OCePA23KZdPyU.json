  {
   "parameters": {
    "jsCode": "const idToName = {};\n\nfor (const item of $('Merge1').all()) {\n  const r = item.json.fields ?? item.json;\n  const recId = item.json.id;\n  const name = r.ID ?? r.Name ?? r.Brand ?? r['Brand owner'] ?? recId;\n  idToName[recId] = String(name);\n}\n\nconst mainItems = $('Fetch Tickets').all();\nfor (const item of mainItems) {\n  const r = item.json.fields ?? item.json;\n  idToName[item.json.id] = String(r.ID ?? r.Name ?? item.json.id);\n}\n\nconst isRecId = (v) => typeof v === 'string' && /^rec[A-Za-z0-9]{14,17}$/.test(v);\n\nreturn mainItems.map(item => {\n  const raw = item.json.fields ?? item.json;\n  const row = {};\n\n  for (const [key, val] of Object.entries(raw)) {\n    if (val == null) {\n      row[key] = '';\n    } else if (Array.isArray(val)) {\n      if (val.length === 0) {\n        row[key] = '';\n      } else if (isRecId(val[0])) {\n        row[key] = val.map(v => idToName[v] ?? v).join(', ');\n      } else if (typeof val[0] === 'object') {\n        row[key] = val.filter(v => v != null).map(v => v.specialValue ?? v.url ?? v.name ?? v.email ?? JSON.stringify(v)).join(', ');\n      } else {\n        row[key] = val.join(', ');\n      }\n    } else if (typeof val === 'object') {\n      row[key] = val.name ?? val.id ?? val.error ?? JSON.stringify(val);\n    } else {\n      row[key] = val;\n    }\n  }\n\n  row['airtable_record_id'] = item.json.id;\n  return { json: row };\n});"
   },
