   "parameters": {
    "jsCode": "const MAIN_TABLE = \"OOS items\"; // ← change if your main table differs\n\n// Your input is [ { tables: [...] } ]\nconst tables = $input.first().json.tables;\nconst main = tables.find(t => t.name === MAIN_TABLE);\nif (!main) throw new Error(`Table \"${MAIN_TABLE}\" not found in schema`);\n\nconst linkedFields = [];\n\nfor (const f of main.fields) {\n  // Case 1: direct linked record field\n  if (f.type === \"multipleRecordLinks\" && f.options?.linkedTableId) {\n    linkedFields.push({\n      fieldName: f.name,\n      linkedTableId: f.options.linkedTableId,\n    });\n  }\n\n  // Case 2: lookup field whose result is itself a record link (returns rec IDs)\n  if (\n    f.type === \"multipleLookupValues\" &&\n    f.options?.isValid &&\n    f.options?.result?.type === \"multipleRecordLinks\"\n  ) {\n    // Resolve which table the underlying link points to:\n    // follow recordLinkFieldId → that link field's target table → the looked-up field's target\n    // Simplest reliable approach: mark it for resolution against ALL fetched tables,\n    // since record IDs are globally unique.\n    linkedFields.push({\n      fieldName: f.name,\n      linkedTableId: null, // resolved via the global ID map\n    });\n  }\n}\n\n// Unique table IDs we actually need to fetch\nconst tablesToFetch = [\n  ...new Set(linkedFields.map(f => f.linkedTableId).filter(Boolean)),\n];\n\n// For your schema this yields: tblBkzDATbdxYdoZo (Menu items), tbl7Y9QHzO1TyWZDl (Tickets)\n// Location/Parent lookups resolve via Locations + Tickets — so add Locations too:\n// Location lookup ultimately points at tbljrW84qbQIoYUBX (Locations)\nif (linkedFields.some(f => f.fieldName === \"Location\")) {\n  if (!tablesToFetch.includes(\"tbljrW84qbQIoYUBX\")) {\n    tablesToFetch.push(\"tbljrW84qbQIoYUBX\");\n  }\n}\n\n// Also stash each table's primaryFieldId so Node 5 can resolve names correctly\nconst primaryFieldByTable = {};\nfor (const t of tables) {\n  const pf = t.fields.find(f => f.id === t.primaryFieldId);\n  primaryFieldByTable[t.id] = pf ? pf.name : \"ID\";\n}\n\nreturn tablesToFetch.map(tableId => ({\n  json: {\n    tableId,\n    primaryFieldName: primaryFieldByTable[tableId],\n    linkedFields: linkedFields.map(f => f.fieldName),\n  },\n}));"
   },
